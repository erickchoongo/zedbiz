# TEMPLATE ONLY. Copy outside Git and fill from the actual provider dashboards.
# Render receives ONLY the application role URL, never admin/migration credentials.
APP_ENV=production
REQUIRE_PRODUCTION=true
DATABASE_SSL_REQUIRED=true
DATABASE_URL=postgresql://zedbiz_app.PROJECT_REF:URL_ENCODED_APP_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full
PGSSLROOTCERT=/etc/secrets/supabase-ca.crt
JWT_SECRET=replace-with-independent-random-jwt-secret
CORS_ORIGINS=https://ACTUAL_PAGES_PROJECT.pages.dev
TRUSTED_HOSTS=ACTUAL_RENDER_SERVICE.onrender.com,127.0.0.1,localhost
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
WEB_CONCURRENCY=1
PYTHON_VERSION=3.12.14
UV_VERSION=0.12.6
# PORT and RENDER_GIT_COMMIT are provided by Render, not Flutter.
# Flutter receives public API_BASE_URL, APP_ENV, version/build/commit only.
