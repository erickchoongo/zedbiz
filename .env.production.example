# Copy OUTSIDE the checkout, restrict permissions, replace every placeholder.
# Generate each secret independently: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_ENV=production
GIT_COMMIT=unknown
BACKEND_VERSION=0.1.0
POSTGRES_DB=zedbiz
POSTGRES_USER=zedbiz_admin
POSTGRES_PASSWORD=replace-with-independent-random-admin-secret
DATABASE_URL=postgresql+psycopg://zedbiz_app:replace-with-independent-random-app-secret@db:5432/zedbiz
MIGRATION_DATABASE_URL=postgresql+psycopg://zedbiz_migrator:replace-with-independent-random-migration-secret@db:5432/zedbiz
ADMIN_DATABASE_URL=postgresql+psycopg://zedbiz_admin:replace-with-independent-random-admin-secret@db:5432/zedbiz
JWT_SECRET=replace-with-independent-random-jwt-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=https://app.example.com
TRUSTED_HOSTS=api.example.com,127.0.0.1
API_DOMAIN=api.example.com
WEB_DOMAIN=app.example.com
ACME_EMAIL=operator@example.com
LOG_LEVEL=INFO
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
WEB_CONCURRENCY=1
RATE_LIMIT_API=600
RATE_LIMIT_LOGIN=30
RATE_LIMIT_ACCOUNT=8
RATE_LIMIT_REGISTER=5
RATE_LIMIT_REFRESH=60
WEB_ROOT=./mobile/build/web
# Public Flutter build settings only; never include DB/JWT secrets in Flutter.
# --dart-define=APP_ENV=production --dart-define=API_BASE_URL=https://api.example.com
# --dart-define=OFFLINE_AUTH_HOURS=24
